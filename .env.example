# Copy to .env for local development. Fill locally; never commit .env.
COMPOSE_PROJECT_NAME=aclara-main
POSTGRES_HOST_PORT=15432
API_HOST_PORT=8000
WEB_HOST_PORT=3000
POSTGRES_USER=aclara
POSTGRES_PASSWORD=
POSTGRES_DB=aclara
# Generated locally by scripts.local_ops; API never uses the owner login.
OPS_APP_PASSWORD=
OPS_BACKEND=postgres
LEDGER_BACKEND=serving
AGENT_SYSTEM=P
DEMO_USERNAME=demo.es.mx
# Fixture-only identity settings; serving uses private Postgres persona bindings.
DEMO_ROLE=customer
DEMO_LOCALE=es-MX
ALLOW_DEMO_RESET=false
DEMO_PASSWORD=
LOCAL_RAW_DIR=
LAKE_DIR=./lake
LLM_PROVIDER=mock
LLM_REAL_CALLS_APPROVED=0
LLM_DAILY_BUDGET_USD=10
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
BANK_CLOCK=2026-06-18T06:00:00Z
