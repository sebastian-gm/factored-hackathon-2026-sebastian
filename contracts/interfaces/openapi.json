    "schemas": {
      "ConfirmBody": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "title": "Confirmed",
            "type": "boolean"
          },
          "proposal_hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Proposal Hash",
            "type": "string"
          }
        },
        "required": [
          "proposal_hash",
          "confirmed"
        ],
        "title": "ConfirmBody",
        "type": "object"
      },
      "DisputeCaseView": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "policy_rules": {
            "items": {
              "type": "string"
            },
            "title": "Policy Rules",
            "type": "array"
          },
          "review_flag": {
            "default": false,
            "title": "Review Flag",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_handle": {
            "title": "Transaction Handle",
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "transaction_handle",
          "status",
          "policy_rules",
          "created_at"
        ],
        "title": "DisputeCaseView",
        "type": "object"
      },
      "FreezeBody": {
        "additionalProperties": false,
        "properties": {
          "confirmed": {
            "title": "Confirmed",
            "type": "boolean"
          },
          "proposal_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Proposal Hash",
            "type": "string"
          }
        },
        "required": [
          "proposal_hash",
          "confirmed"
        ],
        "title": "FreezeBody",
        "type": "object"
      },
      "FreezeRequest": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "default": "es",
            "pattern": "^(es|pt)$",
            "title": "Language",
            "type": "string"
          }
        },
        "title": "FreezeRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HandoffRoute": {
        "additionalProperties": false,
        "properties": {
          "fallback_used": {
            "title": "Fallback Used",
            "type": "boolean"
          },
          "language": {
            "enum": [
              "es",
              "pt"
            ],
            "title": "Language",
            "type": "string"
          },
          "queue": {
            "title": "Queue",
            "type": "string"
          }
        },
        "required": [
          "queue",
          "language",
          "fallback_used"
        ],
        "title": "HandoffRoute",
        "type": "object"
      },
      "HandoffView": {
        "additionalProperties": false,
        "properties": {
          "actions_taken": {
            "items": {
              "type": "string"
            },
            "title": "Actions Taken",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "freeze_outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Freeze Outcome"
          },
          "handoff_id": {
            "title": "Handoff Id",
            "type": "string"
          },
          "open_questions": {
            "items": {
              "type": "string"
            },
            "title": "Open Questions",
            "type": "array"
          },
          "priority": {
            "enum": [
              "normal",
              "high"
            ],
            "title": "Priority",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
