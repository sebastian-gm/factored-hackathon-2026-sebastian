          "handle": {
            "title": "Handle",
            "type": "string"
          },
          "product_type": {
            "title": "Product Type",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "product_type",
          "status"
        ],
