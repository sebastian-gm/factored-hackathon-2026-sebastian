            "enum": [
              "cancelled",
              "handoff_created",
              "abstained_out_of_scope",
              "choose_transaction",
              "clarification",
              "dispute_filed",
              "dispute_proposed",
              "explained",
              "status_reported",
              "refused_security"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "policy_rules": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Rules"
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProposalView"
              },
              {
                "type": "null"
              }
            ]
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          },
          "response_type": {
            "enum": [
              "cancelled",
              "offer_human",
              "abstain",
              "choose_transaction",
              "clarify",
              "report_case",
              "confirm_action",
              "explain_status",
              "report_status",
              "refuse"
            ],
            "title": "Response Type",
            "type": "string"
          },
          "session_ended": {
            "default": false,
            "title": "Session Ended",
            "type": "boolean"
          },
          "transaction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TransactionView"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified"
          }
        },
        "required": [
          "response_type",
          "outcome",
          "reply"
        ],
        "title": "ResponsePlan",
        "type": "object"
      },
      "StepUpBody": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "maxLength": 160,
            "title": "Challenge Id",
            "type": "string"
          },
