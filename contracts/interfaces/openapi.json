        "additionalProperties": false,
        "description": "Validated API action plan; required detail depends on response_type.",
        "properties": {
          "candidates": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TransactionView"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidates"
          },
          "case": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DisputeCaseView"
              },
              {
                "type": "null"
              }
            ]
          },
          "freeze_offer": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProductView"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Freeze Offer"
