            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "policy_rules": {
            "items": {
              "type": "string"
            },
            "title": "Policy Rules",
            "type": "array"
          },
          "proposal_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Proposal Hash",
            "type": "string"
          }
