        "additionalProperties": false,
        "properties": {
          "message": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageBody",
        "type": "object"
      },
      "OtpBody": {
        "additionalProperties": false,
        "properties": {
          "challenge_id": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Challenge Id",
            "type": "string"
          },
          "code": {
            "pattern": "^\\d{6}$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "challenge_id",
          "code"
        ],
        "title": "OtpBody",
        "type": "object"
      },
