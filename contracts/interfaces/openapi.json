            "title": "Merchant"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "transaction_date": {
            "format": "date-time",
            "title": "Transaction Date",
            "type": "string"
          },
          "transaction_type": {
            "title": "Transaction Type",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "transaction_date",
          "transaction_type",
          "amount",
          "currency",
          "merchant",
          "status"
        ],
        "title": "TransactionView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
