              "$ref": "#/$defs/MessageTurn"
            },
            {
              "$ref": "#/$defs/ConfirmationTurn"
            }
          ]
        },
        "minItems": 1,
        "title": "Turns",
        "type": "array"
      },
      "utterance_provenance": {
        "$ref": "#/$defs/AuthoringProvenance"
      }
    },
    "required": [
      "id",
      "language",
      "turns",
      "expected"
    ],
    "type": "object"
  }
}
