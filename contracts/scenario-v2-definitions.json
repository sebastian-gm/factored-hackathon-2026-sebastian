        "$ref": "#/$defs/ReactiveReplies"
      },
      "reply_exhaustion": {
        "const": "repeat_last"
      },
      "template_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "turns": {
        "items": {
          "anyOf": [
